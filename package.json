{
  "name": "econib",
  "private": true,
  "version": "0.1.0",
  "description": "IB Economics study and self-assessment tool for econib.org",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs && node scripts/syntax-check.mjs",
    "verify": "npm run test && npm run check",
    "dev": "wrangler pages dev --port 8788",
    "db:local": "wrangler d1 execute econib --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute econib --remote --file=./schema.sql",
    "sync-data": "cp data/*.json public/assets/data/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  },
  "devDependencies": {
    "wrangler": "^4.129.0"
  }
}
